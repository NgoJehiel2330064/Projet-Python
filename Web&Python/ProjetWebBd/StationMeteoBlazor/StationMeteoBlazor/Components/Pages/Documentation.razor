@page "/documentation"
@using System.Text.Json
@inject NavigationManager NavigationManager

<PageTitle>Documentation - StationMeteoBlazor</PageTitle>

<div class="container py-5 documentation-wrapper">
    <div class="row">
        <!-- SIDEBAR -->
        <aside class="col-lg-3 mb-4">
            <div class="sticky-top" style="top:90px;">
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="mb-2 fw-bold">Documentation</h5>
                        <p class="text-muted small mb-3">Guide & API • StationMeteoBlazor</p>

                        <nav class="nav flex-column">
                            <a class="nav-link py-1" href="#overview">Présentation</a>
                            <a class="nav-link py-1" href="#quickstart">Quick start</a>
                            <a class="nav-link py-1" href="#endpoints">Endpoints</a>
                            <a class="nav-link py-1" href="#models">Modèles</a>
                            <a class="nav-link py-1" href="#auth">Authentification</a>
                            <a class="nav-link py-1" href="#examples">Exemples</a>
                            <a class="nav-link py-1" href="#changelog">Changelog</a>
                            <a class="nav-link py-1" href="#contact">Contact</a>
                        </nav>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <small class="text-muted">Version</small>
                        <!-- ❗ Dynamique : remplacer par la version réelle de l'app -->
                        <div class="fw-semibold">v1.0.0</div>

                        <hr />

                        <small class="text-muted">État</small>
                        <!-- ❗ Dynamique : état (ex: beta, prod) -->
                        <div class="text-success fw-semibold">Production</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="col-lg-9">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 id="overview" class="fw-bold mb-3">Présentation</h2>
                    <p class="lead text-muted">
                        StationMeteoBlazor est une application de suivi météo et support utilisateur.
                        Cette documentation décrit les endpoints disponibles, les modèles de données,
                        et donne des exemples d'utilisation pour intégration front/back.
                    </p>

                    <div class="row g-3 mt-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <small class="text-muted">Base URL</small>
                                <div class="fw-semibold">https://api.example.com</div>
                                <!-- ❗ Remplacer par l'URL réelle -->
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <small class="text-muted">Format</small>
                                <div class="fw-semibold">JSON</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- QUICK START -->
            <div class="card shadow-sm mb-4" id="quickstart">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Quick start</h4>
                    <ol>
                        <li>Obtenir un token via l'endpoint de connexion (voir <a href="#auth">Authentification</a>).</li>
                        <li>Appeler les endpoints en ajoutant l'entête <code>Authorization: Bearer &lt;token&gt;</code>.</li>
                        <li>Consommer les données JSON et afficher dans ton UI.</li>
                    </ol>

                    <div class="alert alert-info mt-3 mb-0">
                        <strong>Astuce :</strong> commence par tester les endpoints avec <code>curl</code> ou Postman.
                    </div>
                </div>
            </div>

            <!-- ENDPOINTS -->
            <div class="card shadow-sm mb-4" id="endpoints">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Endpoints clés</h4>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Route</th>
                                    <th>Méthode</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>GET /api/users/{id}</code></td>
                                    <td><span class="badge bg-secondary">GET</span></td>
                                    <td>Récupère les informations publiques d'un utilisateur (Nom, Email, DateCreation).</td>
                                </tr>
                                <tr>
                                    <td><code>GET /api/donnees/{userId}</code></td>
                                    <td><span class="badge bg-secondary">GET</span></td>
                                    <td>Retourne la liste des mesures pour un utilisateur.</td>
                                </tr>
                                <tr>
                                    <td><code>POST /api/donnees</code></td>
                                    <td><span class="badge bg-primary">POST</span></td>
                                    <td>Insère une nouvelle mesure (Température, Humidité, Pression, ...).</td>
                                </tr>
                                <tr>
                                    <td><code>POST /api/auth/login</code></td>
                                    <td><span class="badge bg-warning text-dark">AUTH</span></td>
                                    <td>Authentification — retourne un <code>JWT</code> ou session token.</td>
                                </tr>
                                <!-- ❗ Ajouter d'autres endpoints réels ici -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODELES -->
            <div class="card shadow-sm mb-4" id="models">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Modèles de données (exemples)</h4>

                    <h6 class="mb-2">Utilisateur</h6>
                    <pre class="bg-dark text-white p-3 rounded"><code>{
  "IdUtilisateur": 1,
  "Nom": "Dupont",
  "Prenom": "Jean",
  "Email": "jean.dupont@example.com",
  "DateCreation": "2025-01-01T12:00:00"
}</code></pre>

                    <h6 class="mb-2 mt-3">DonneeCapteur</h6>
                    <pre class="bg-dark text-white p-3 rounded"><code>{
  "IdDonneeCapteur": 19,
  "IdUtilisateur": 1,
  "DateMesure": "2025-10-01T12:43:12",
  "Temperature": 18.5,
  "Humidite": 75.0,
  "Pression": 1015.0,
  "Lumiere": 900.0,
  "Pluie": 1.0,
  "VentDirection": 180.0,
  "VentVitesse": 50.0
}</code></pre>

                    <small class="text-muted">❗ Remplace ces exemples par tes modèles EF Core réels si nécessaire.</small>
                </div>
            </div>

            <!-- AUTH -->
            <div class="card shadow-sm mb-4" id="auth">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Authentification</h4>

                    <p>Nous utilisons un mécanisme standard Bearer token (JWT) ou sessions selon ton implémentation.</p>

                    <h6 class="mt-3">Exemple Curl (login)</h6>
                    <pre class="p-3 bg-light rounded"><code>curl -X POST https://api.example.com/api/auth/login \
-H "Content-Type: application/json" \
-d '{"email":"jean.dupont@example.com","password":"monMotDePasse"}'
</code></pre>

                    <h6 class="mt-3">Exemple HttpClient C#</h6>
                    <pre class="p-3 bg-light rounded"><code>// Exemple d'appel POST pour obtenir un token
var payload = JsonSerializer.Serialize(new { email = "jean.dupont@example.com", password = "monMotDePasse" });
var response = await httpClient.PostAsync("/api/auth/login", new StringContent(payload, Encoding.UTF8, "application/json"));
response.EnsureSuccessStatusCode();
var json = await response.Content.ReadAsStringAsync();
// parse token...
</code></pre>

                    <p class="text-muted small mt-2">❗ Après récupération du token, ajoute l'entête <code>Authorization: Bearer &lt;token&gt;</code>.</p>
                </div>
            </div>

            <!-- EXAMPLES -->
            <div class="card shadow-sm mb-4" id="examples">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Exemples d'utilisation</h4>

                    <h6>Récupérer la dernière mesure (JavaScript / fetch)</h6>
                    <pre class="p-3 bg-light rounded"><code>fetch('/api/donnees/1?limit=1', {
  headers: { 'Authorization': 'Bearer TOKEN' }
})
  .then(r => r.json())
  .then(data => console.log(data));
</code></pre>

                    <h6 class="mt-3">Poster une nouvelle mesure (cURL)</h6>
                    <pre class="p-3 bg-light rounded"><code>curl -X POST https://api.example.com/api/donnees \
-H "Authorization: Bearer TOKEN" \
-H "Content-Type: application/json" \
-d '{
  "IdUtilisateur":1,
  "DateMesure":"2025-10-01T12:43:12",
  "Temperature":18.5,
  "Humidite":75.0
}'</code></pre>
                </div>
            </div>

            <!-- CHANGELOG -->
            <div class="card shadow-sm mb-4" id="changelog">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Changelog</h4>
                    <!-- ❗ Dynamique : récupérer les releases depuis la BD ou un fichier -->
                    <ul class="list-unstyled">
                        <li><strong>v1.0.0</strong> — Lancement initial (pages profil, paramètres, capteurs).</li>
                        <li><strong>v1.1.0</strong> — Amélioration UI, gestion des thèmes.</li>
                    </ul>
                </div>
            </div>

            <!-- CONTACT -->
            <div class="card shadow-sm mb-4" id="contact">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Contact & support</h4>
                    <p class="mb-1">Besoin d'aide ? Ouvre un ticket via <a href="/support">la page support</a>.</p>
                    <p class="small text-muted mb-0">Auteur: TonNom • Email: <em>dev@example.com</em></p>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="text-center text-muted small mt-3">
                Documentation générée — StationMeteoBlazor
            </div>
        </main>
    </div>
</div>

<style>
    .documentation-wrapper {
        animation: fadeIn .25s ease-in-out;
    }

    pre code {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .sticky-top .card {
        border-left: 3px solid rgba(27,110,194,0.12);
    }
</style>

@code {
    // Faux modèle pour éviter les erreurs si la page est chargée sans backend
    // ❗ Remplace / supprime ces données par du contenu dynamique si nécessaire
    protected override void OnInitialized()
    {
        // Charger dynamiquement la version ou le changelog si besoin
    }
}
