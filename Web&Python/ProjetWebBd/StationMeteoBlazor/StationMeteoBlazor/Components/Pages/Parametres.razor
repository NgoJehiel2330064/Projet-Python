@page "/parametres"
@using StationMeteoBlazor.Data
@using StationMeteoBlazor.Models
@inject SupportService SupportService
@inject DonneeCapteurService DonneeCapteurService
@inject ParmService ParmService
@inject AuthenticationStateProvider AuthStateProvider


<PageTitle>Paramètres</PageTitle>

<div class="container py-5 settings-wrapper">

    <h3 class="fw-bold mb-4">Paramètres et tableau de bord</h3>

    @if (isLoading)
    {
        <p>Chargement...</p>
    }
    else if (dernieresMesures == null)
    {
        <p>Aucune donnée disponible pour votre compte.</p>
    }
    else
    {
        <!-- ============================ -->
        <!-- SECTION : Compte utilisateur -->
        <!-- ============================ -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Informations du compte</h5>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Nom</div>
                    <div class="col-sm-8">@utilisateur.Nom</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Prénom</div>
                    <div class="col-sm-8">@utilisateur.Prenom</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Email</div>
                    <div class="col-sm-8">@utilisateur.Email</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Date de Création</div>
                    <div class="col-sm-8">@utilisateur.DateCreation</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Nombre de commentaire</div>
                    <div class="col-sm-8">@utilisateur.Commentaires.Count</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Nombre de Tickets</div>
                    <div class="col-sm-8">@utilisateur.Tickets.Count</div>
                </div>
                <div class=" d-flex justify-content-between ">

                    <AuthorizeView>
                         <Authorized Context="auth">
                             <AuthorizeView Roles="Admin">
                                <div class="mt-3">
                                    <a class="btn btn-outline-success" href="/admin/add">
                                        ajouter un admin
                                    </a>
                                </div>
                             </AuthorizeView>

                         </Authorized>

                    </AuthorizeView>

                    <div class="mt-3">
                        <a class="btn btn-outline-primary" href="/profile/edit">
                            Modifier mon profil
                        </a>
                    </div>


                </div>


            </div>

        </div>
        <!-- ============================ -->
        <!-- SECTION : Dernières mesures -->
        <!-- ============================ -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Dernières mesures météo</h5>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Date de la mesure</div>
                    <div class="col-sm-8">@dernieresMesures.DateMesure.ToString("g")</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Température (°C)</div>
                    <div class="col-sm-8">@dernieresMesures.Temperature</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Humidité (%)</div>
                    <div class="col-sm-8">@dernieresMesures.Humidite</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Pression (hPa)</div>
                    <div class="col-sm-8">@dernieresMesures.Pression</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Lumière</div>
                    <div class="col-sm-8">@dernieresMesures.Lumiere</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Pluie</div>
                    <div class="col-sm-8">@dernieresMesures.Pluie</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Vent vitesse</div>
                    <div class="col-sm-8">@dernieresMesures.VentVitesse</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 fw-semibold">Vent direction</div>
                    <div class="col-sm-8">@dernieresMesures.VentDirection</div>
                </div>
            </div>
        </div>

        <!-- ============================ -->
        <!-- SECTION : Apparence / Thème -->
        <!-- ============================ -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Apparence</h5>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="darkModeToggle"
                           @bind="darkMode">

                    <label class="form-check-label fw-semibold" for="darkModeToggle">
                        Activer le mode sombre
                    </label>
                </div>

                <button class="btn btn-primary mt-3" @onclick="SavePreferences">
                    Sauvegarder
                </button>

                @if (saved)
                {
                    <div class="alert alert-success mt-3">
                        Paramètres sauvegardés !
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .settings-wrapper {
        animation: fadeIn .3s ease-in-out;
    }

    body.dark-mode .card {
        background: #1e1e1e !important;
        color: #f1f1f1 !important;
    }
</style>

@code {
    bool isLoading = true;
    bool saved = false;
    bool darkMode = false;

    DonneeCapteur? dernieresMesures;
    Utilisateur? utilisateur;
    int userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        // ⚠️ Récupérer l'ID utilisateur depuis les claims
        userId = int.Parse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");

        // ⚠️ On prend la dernière mesure
        dernieresMesures = await ParmService.GetAllAsync(userId);


        // ⚠️ Récupérer l'utilisateur depuis SupportService ou UserService
        utilisateur = await ParmService.GetUtilisateurById(userId); // ⚠️ méthode à créer dans SupportService

        // ⚠️ Charger le mode sombre depuis la BD ou LocalStorage
        darkMode = false;

        isLoading = false;
    }

    private async Task SavePreferences()
    {
        // ⚠️ Sauvegarder les préférences utilisateur (mode sombre) plus tard
        saved = true;
        await Task.Delay(1500);
        saved = false;
    }
}
