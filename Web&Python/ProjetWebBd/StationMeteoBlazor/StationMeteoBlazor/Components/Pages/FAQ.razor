@page "/faq"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<PageTitle>FAQ</PageTitle>

<div class="container my-5">
    <h1 class="text-center mb-4 fw-bold">
        <i class="bi bi-question-circle text-primary"></i> Foire Aux Questions
    </h1>

    <p class="text-center text-muted mb-5">
        Retrouvez ici les réponses aux questions les plus fréquentes concernant votre station météo, votre compte utilisateur et l’application.
    </p>

    <div class="accordion shadow-sm" id="faqAccordion">

        <!-- Compte et authentification -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq1" aria-expanded="true" aria-controls="faq1">
                    Comment créer un compte ?
                </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Cliquez sur le bouton <strong>Inscription</strong> dans le menu. Remplissez vos informations
                    puis validez. Vous pourrez ensuite connecter vos capteurs à votre compte.
                </div>
            </div>
        </div>

        <!-- Capteurs -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                    Comment ajouter un capteur à mon compte ?
                </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Rendez-vous sur la page <strong>Dashboard</strong>, section <em>Capteurs</em>. Cliquez sur
                    <strong>Ajouter un capteur</strong> et entrez le code associé à votre appareil.
                </div>
            </div>
        </div>

        <!-- Alerte météo -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingThree">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                    Comment fonctionnent les alertes météo ?
                </button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Vous pouvez créer des alertes personnalisées basées sur la température, l’humidité, le vent ou
                    d’autres paramètres. Lorsqu’une valeur dépasse un seuil défini, une notification est générée
                    dans votre tableau de bord.
                </div>
            </div>
        </div>

        <!-- Mode sombre -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq4">
                    Comment activer le mode sombre ?
                </button>
            </h2>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Cliquez sur l’icône <i class="bi bi-moon-stars"></i> dans la barre de navigation.
                    Vos préférences seront automatiquement sauvegardées pour vos prochaines visites.
                </div>
            </div>
        </div>

        <!-- Gestion de compte -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq5">
                    Comment modifier mes informations de compte ?
                </button>
            </h2>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Rendez-vous sur la page <strong>Mon Profil</strong>. Vous pourrez modifier votre nom, email,
                    mot de passe ainsi que vos paramètres personnels.
                </div>
            </div>
        </div>

        <!-- Sécurité -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq6">
                    Mes données sont-elles sécurisées ?
                </button>
            </h2>
            <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Oui. Nous encryptons toutes les données sensibles et appliquons les normes de sécurité modernes :
                    <ul>
                        <li>Hashage des mots de passe</li>
                        <li>Connexion HTTPS</li>
                        <li>Validation des données côté client & serveur</li>
                        <li>Rôles utilisateur (User / Admin)</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Support -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq7">
                    Comment contacter le support ?
                </button>
            </h2>
            <div id="faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Rendez-vous sur la page <strong>Support</strong> pour ouvrir un ticket.
                    Une équipe répond généralement en moins de 24h.
                </div>
            </div>
        </div>

    </div>
</div>
