@page "/profile"
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Profil Utilisateur</PageTitle>

<div class="container mt-4">

    <h2 class="mb-4">Profil Utilisateur</h2>

    <!-- Le modèle statique requis pour éviter l'erreur EditForm -->
    @code {
        public class FakeUserModel
        {
            public string Nom { get; set; } = "";
            public string Prenom { get; set; } = "";
            public string Email { get; set; } = "";
            public int Age { get; set; }
        }

        private FakeUserModel formModel = new();
    }

    <!-- FORMULAIRE DU PROFIL UTILISATEUR -->
    <!-- COMMENTAIRE : Ici, on injectera plus tard les vraies valeurs de l'utilisateur connecté -->
    <EditForm Model="formModel">

        <div class="card p-4 shadow-sm">

            <!-- Champ Nom -->
            <!-- COMMENTAIRE : afficher le nom de l'utilisateur -->
            <div class="mb-3">
                <label class="form-label fw-bold">Nom</label>
                <input class="form-control" @bind="formModel.Nom" placeholder="Nom" />
            </div>

            <!-- Champ Prénom -->
            <!-- COMMENTAIRE : afficher le prénom de l'utilisateur -->
            <div class="mb-3">
                <label class="form-label fw-bold">Prénom</label>
                <input class="form-control" @bind="formModel.Prenom" placeholder="Prénom" />
            </div>

            <!-- Champ Email -->
            <!-- COMMENTAIRE : afficher l'email de l'utilisateur -->
            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" class="form-control" @bind="formModel.Email" placeholder="Email" />
            </div>

            <!-- Champ Âge -->
            <!-- COMMENTAIRE : afficher l’âge de l’utilisateur -->
            <div class="mb-3">
                <label class="form-label fw-bold">Âge</label>
                <input type="number" class="form-control" @bind="formModel.Age" placeholder="Âge" />
            </div>

            <button class="btn btn-primary mt-3" type="submit">Enregistrer</button>

        </div>
    </EditForm>

    <!-- AVATAR + MENU UTILISATEUR -->
    <div class="mt-5">
        <div class="dropdown">

            <!-- COMMENTAIRE : ici viendra le nom de l’utilisateur connecté -->
            <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-2"
                    type="button" id="userDropdown" data-bs-toggle="dropdown">

                <!-- COMMENTAIRE : avatar dynamique plus tard -->
                <img src="https://ui-avatars.com/api/?name=U&background=1b6ec2&color=fff"
                     class="rounded-circle" height="28" alt="Avatar" />

                <!-- COMMENTAIRE : nom complet de l'utilisateur -->
                <span class="d-none d-md-inline">Utilisateur</span>
            </button>

            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/profile">Mon profil</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><button class="dropdown-item text-danger">Déconnexion</button></li>
            </ul>

        </div>
    </div>

</div>
