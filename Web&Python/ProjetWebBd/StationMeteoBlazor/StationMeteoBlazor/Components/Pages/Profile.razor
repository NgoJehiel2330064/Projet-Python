@page "/profile/edit"
@using StationMeteoBlazor.Models
@using StationMeteoBlazor.Data
@inject UserService UserService
@inject ParmService parmService
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

<h2 class="mb-4">Modifier votre profil</h2>

@if (loading)
{
    <p>Chargement...</p>
}
else if (utilisateur == null)
{
    <div class="alert alert-danger">
        Impossible de charger les informations du compte.
    </div>
}
else
{
    <div class="card shadow-sm p-4">

        <h4 class="mb-3"><i class="bi bi-person-circle me-2"></i>Informations du compte</h4>

        <table class="table table-bordered align-middle">
            <tbody>
                <!-- NOM -->
                <tr>
                    <th style="width: 25%;">Nom</th>
                    <td>
                        @if (editField == "nom")
                        {
                            <input class="form-control" @bind="editModel.Nom" />
                        }
                        else
                        {
                            @utilisateur.Nom
                        }
                    </td>
                    <td style="width: 120px;">
                        @if (editField == "nom")
                        {
                            <button class="btn btn-success btn-sm" @onclick="@(() => SaveField("nom"))">
                                <i class="bi bi-check-circle"></i> Save
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="@(() => Edit("nom"))">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                        }
                    </td>
                </tr>

                <!-- PRENOM -->
                <tr>
                    <th>Prénom</th>
                    <td>
                        @if (editField == "prenom")
                        {
                            <input class="form-control" @bind="editModel.Prenom" />
                        }
                        else
                        {
                            @utilisateur.Prenom
                        }
                    </td>
                    <td>
                        @if (editField == "prenom")
                        {
                            <button class="btn btn-success btn-sm" @onclick="@(() => SaveField("prenom"))">
                                <i class="bi bi-check-circle"></i> Save
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="@(() => Edit("prenom"))">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                        }
                    </td>
                </tr>

                <!-- EMAIL -->
                <tr>
                    <th>Adresse courriel</th>
                    <td>
                        @if (editField == "email")
                        {
                            <input class="form-control" @bind="editModel.Email" />
                        }
                        else
                        {
                            @utilisateur.Email
                        }
                    </td>
                    <td>
                        @if (editField == "email")
                        {
                            <button class="btn btn-success btn-sm" @onclick="@(() => SaveField("email"))">
                                <i class="bi bi-check-circle"></i> Save
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="@(() => Edit("email"))">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                        }
                    </td>
                </tr>

            </tbody>
        </table>

        <!-- MESSAGE -->
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert mt-3 @(isSuccess ? "alert-success" : "alert-danger")">
                @message
            </div>
        }
    </div>
}

@code {
    private Utilisateur? utilisateur;
    private Utilisateur? editModel = new();
    private bool loading = true;
    private string? editField;
    private string? message;
    private bool isSuccess;
    int userId;

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User;

        // ⚠️ Récupérer l'ID utilisateur depuis les claims
        userId = int.Parse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");

        utilisateur = await UserService.GetUserById(userId);

        loading = false;
    }

    private void Edit(string field)
    {
        editField = field;

        // Copy current values
        editModel = new Utilisateur
        {
            IdUtilisateur = utilisateur.IdUtilisateur,
            Nom = utilisateur.Nom,
            Prenom = utilisateur.Prenom,
            Email = utilisateur.Email
        };
    }

    private async Task SaveField(string field)
    {
        message = null;

        bool ok = await UserService.UpdateUserField(editModel.IdUtilisateur, field, field switch
        {
            "nom" => editModel.Nom,
            "prenom" => editModel.Prenom,
            "email" => editModel.Email,
            _ => ""
        });

        if (!ok)
        {
            message = "Une erreur est survenue lors de la mise à jour.";
            isSuccess = false;
            return;
        }

        // Update displayed values
        switch (field)
        {
            case "nom": utilisateur.Nom = editModel.Nom; break;
            case "prenom": utilisateur.Prenom = editModel.Prenom; break;
            case "email": utilisateur.Email = editModel.Email; break;
        }

        editField = null;
        message = "Changement enregistré avec succès !";
        isSuccess = true;
    }
}
